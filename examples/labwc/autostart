#!/bin/sh
# ~/.config/labwc/autostart
# Copy to ~/.config/labwc/autostart, chmod +x.
#
# Runs when labwc itself starts. Use to launch immframe and any helpers.

# Start the slideshow; pipe output to the journal under tag 'immframe' so
# you can read live logs with:    journalctl -t immframe -f
~/immframe/.venv/bin/immframe 2>&1 | systemd-cat -t immframe &
